// Schéma Prisma — cercle de parieurs (phase 1 : ~30 comptes).
// Postgres (ex: Vercel Postgres / Neon / Supabase) : le système de fichiers
// de Vercel étant éphémère en production, SQLite n'y fonctionne pas — voir
// DATABASE_URL dans .env.example.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BetStatus {
  PENDING
  WON
  LOST
}

/**
 * Un tournoi = un event start.gg suivi, affiché comme onglet dans l'app.
 * Les paris (Bet) sont rattachés par eventSlug, pas par une clé étrangère :
 * l'historique d'un tournoi reste consultable même si son slug change de
 * nom d'affichage, et rien n'empêche deux tournois différents d'avoir
 * existé sur le même slug au fil du temps.
 */
model Tournament {
  id            String   @id @default(cuid())
  name          String
  eventSlug     String   @unique
  // Chaîne Twitch à afficher en lecteur intégré sur les pages du tournoi
  // (juste le nom de la chaîne, ex: "mk_rza"), renseignée par un admin.
  twitchChannel String?
  // Identifiant de l'abonnement EventSub Twitch actif pour cette chaîne
  // (permet de le retrouver pour le supprimer/recréer).
  twitchSubscriptionId String?
  // Set start.gg actuellement "en direct" côté chat Twitch : les commandes
  // !bet du chat parient sur ce match, choisi manuellement par un admin.
  activeChatSetId       String?
  createdAt     DateTime @default(now())
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String?
  // Champs prêts pour la phase 2 (connexion via un connecteur externe :
  // start.gg ou Discord) sans avoir à retoucher le modèle de données.
  discordId    String?  @unique
  startggId    String?  @unique
  // Identifiant numérique Twitch (chatter_user_id) — rempli automatiquement
  // quand quelqu'un parie depuis le chat sans compte préexistant sur le site.
  twitchId     String?  @unique
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  bets         Bet[]
}

/**
 * Jeton d'accès du compte Twitch "bot" utilisé pour lire le chat via
 * EventSub. Ligne unique (id fixe) — les tokens Twitch expirent et le
 * refresh token change à chaque rafraîchissement, donc on les persiste ici
 * plutôt que dans une variable d'environnement statique.
 */
model TwitchBotToken {
  id           String   @id @default("singleton")
  twitchUserId String
  login        String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt
}

model Bet {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Identifiant du "set" (match) côté start.gg.
  setId                 String
  eventSlug             String
  // Snapshot des infos du match au moment du pari, pour affichage même si
  // l'API start.gg change ou devient indisponible par la suite.
  roundText             String
  predictedEntrantId    String
  predictedEntrantName  String
  status                BetStatus @default(PENDING)
  pointsAwarded         Int       @default(0)
  createdAt             DateTime  @default(now())
  resolvedAt            DateTime?

  @@unique([userId, setId])
  @@index([setId])
}
