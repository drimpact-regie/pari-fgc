// Schéma Prisma — cercle de parieurs (phase 1 : ~30 comptes).
// Postgres (ex: Vercel Postgres / Neon / Supabase) : le système de fichiers
// de Vercel étant éphémère en production, SQLite n'y fonctionne pas — voir
// DATABASE_URL dans .env.example.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BetStatus {
  PENDING
  WON
  LOST
}

/**
 * Un tournoi = un event start.gg suivi, affiché comme onglet dans l'app.
 * Les paris (Bet) sont rattachés par eventSlug, pas par une clé étrangère :
 * l'historique d'un tournoi reste consultable même si son slug change de
 * nom d'affichage, et rien n'empêche deux tournois différents d'avoir
 * existé sur le même slug au fil du temps.
 */
model Tournament {
  id            String   @id @default(cuid())
  name          String
  eventSlug     String   @unique
  // Chaîne Twitch à afficher en lecteur intégré sur les pages du tournoi
  // (juste le nom de la chaîne, ex: "mk_rza"), renseignée par un admin.
  twitchChannel String?
  // Identifiant de l'abonnement EventSub Twitch actif pour cette chaîne
  // (permet de le retrouver pour le supprimer/recréer).
  twitchSubscriptionId String?
  // Set start.gg actuellement "en direct" côté chat Twitch : les commandes
  // !bet du chat parient sur ce match, choisi manuellement par un admin.
  activeChatSetId       String?
  // Verrouille les pronostics Top 8 (plus aucune modification possible, web
  // ou chat) — activé manuellement par un admin au moment où le tournoi
  // entre en phase Top 8.
  topEightLocked Boolean  @default(false)
  // Verrouille le pari "Reset de bracket" (Le Pari du Parry) — séparé du
  // verrou Top 8 car son timing naturel est bien plus tardif (juste avant
  // la grande finale, pas avant le top 8).
  bracketResetLocked Boolean @default(false)
  // Résultat réel du reset de bracket en grande finale, saisi par un admin
  // après le tournoi (auto-détecté quand possible via un set "Grand Final
  // Reset" côté start.gg, mais reste modifiable manuellement).
  bracketResetActual Boolean?
  // Dernier passage de détection des résultats de phases finales (annonce
  // chat + résolution des paris classiques), déclenché à l'occasion des
  // messages du chat Twitch — sert de garde-fou pour éviter d'interroger
  // start.gg à chaque message (voir lib/matchResults.ts).
  lastResultsCheckAt DateTime?
  createdAt     DateTime @default(now())
}

/**
 * Marque un set de phase finale tardive (Top N, Grand Final...) dont le
 * résultat a déjà été annoncé dans le chat Twitch, pour ne pas le
 * réannoncer aux passages de détection suivants (voir lib/matchResults.ts).
 */
model AnnouncedSetResult {
  id        String   @id @default(cuid())
  setId     String   @unique
  eventSlug String
  createdAt DateTime @default(now())
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String?
  // Champs prêts pour la phase 2 (connexion via un connecteur externe :
  // start.gg ou Discord) sans avoir à retoucher le modèle de données.
  discordId    String?  @unique
  startggId    String?  @unique
  // Identifiant numérique Twitch (chatter_user_id) — rempli automatiquement
  // quand quelqu'un parie depuis le chat sans compte préexistant sur le site.
  twitchId     String?  @unique
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  bets         Bet[]
  topEightPicks TopEightPick[]
  mvcBets        MvcBet[]
  bracketResetBets BracketResetBet[]
}

/**
 * Pronostic "Top 8" d'un parieur pour un tournoi donné : les 8 joueurs
 * qu'il pense voir finir dans le top 8. Une ligne par utilisateur et par
 * tournoi (comme Bet, rattaché par eventSlug plutôt que par relation vers
 * Tournament, pour garder l'historique même si le tournoi est renommé).
 */
model TopEightPick {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventSlug String
  // [{ entrantId: string, entrantName: string }, ...] — jusqu'à 8, dans
  // l'ordre de sélection.
  picks     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, eventSlug])
}

/**
 * Roster de personnages jouables d'un jeu, réutilisable par tous les
 * tournois de ce jeu (identifié par le nom renvoyé par start.gg via
 * `event.videogame.name`). `imageUrl` reste vide quand aucune image fiable
 * n'a été trouvée — à compléter manuellement plutôt que d'afficher un
 * visuel potentiellement incorrect.
 */
model Character {
  id        String   @id @default(cuid())
  game      String
  name      String
  imageUrl  String?
  createdAt DateTime @default(now())
  mvcBets   MvcBet[]

  @@unique([game, name])
}

/**
 * Pari "MVC" (Most Valuable Character) — Le Pari du Parry : un joueur parie
 * qu'un personnage donné apparaîtra un certain nombre de fois dans le top 8
 * du tournoi. L'API start.gg n'expose pas le personnage joué par chaque
 * entrant, donc `actualCount` est saisi manuellement par un admin après le
 * tournoi (même valeur répliquée sur tous les paris portant sur ce
 * personnage pour ce tournoi, plutôt qu'une table de résultats séparée).
 */
model MvcBet {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventSlug      String
  characterId    String
  character      Character @relation(fields: [characterId], references: [id])
  predictedCount Int
  actualCount    Int?
  status         BetStatus @default(PENDING)
  pointsAwarded  Int       @default(0)
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  @@unique([userId, eventSlug])
  @@index([eventSlug, characterId])
}

/**
 * Pari "Reset de bracket" (Oui/Non) — Le Pari du Parry : le joueur venant du
 * loser bracket gagne-t-il le premier set de la grande finale, forçant un
 * second set (bracket reset) ? Résultat réel sur Tournament.bracketResetActual.
 */
model BracketResetBet {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventSlug     String
  predictedYes  Boolean
  status        BetStatus @default(PENDING)
  pointsAwarded Int       @default(0)
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?

  @@unique([userId, eventSlug])
}

/**
 * Jeton d'accès du compte Twitch "bot" utilisé pour lire le chat via
 * EventSub. Ligne unique (id fixe) — les tokens Twitch expirent et le
 * refresh token change à chaque rafraîchissement, donc on les persiste ici
 * plutôt que dans une variable d'environnement statique.
 */
model TwitchBotToken {
  id           String   @id @default("singleton")
  twitchUserId String
  login        String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt
}

model Bet {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Identifiant du "set" (match) côté start.gg.
  setId                 String
  eventSlug             String
  // Snapshot des infos du match au moment du pari, pour affichage même si
  // l'API start.gg change ou devient indisponible par la suite.
  roundText             String
  predictedEntrantId    String
  predictedEntrantName  String
  // Score exact pronostiqué (optionnel, bonus de points) : manches gagnées
  // par le joueur pronostiqué vainqueur / par son adversaire.
  predictedEntrantScore  Int?
  predictedOpponentScore Int?
  // Snapshot des têtes de série au moment du pari, pour calculer le bonus
  // "outsider" à la résolution sans dépendre de données start.gg qui
  // peuvent ne plus être exposées de la même façon plus tard dans le
  // tournoi.
  predictedEntrantSeed   Int?
  opponentSeed           Int?
  // Format du set (Bo3 = 3, Bo5 = 5, ...), pour calibrer le bonus de score
  // exact à la résolution.
  totalGames             Int?
  status                BetStatus @default(PENDING)
  pointsAwarded         Int       @default(0)
  createdAt             DateTime  @default(now())
  resolvedAt            DateTime?

  @@unique([userId, setId])
  @@index([setId])
}
