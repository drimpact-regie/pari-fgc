# --- start.gg ---
# Token d'API start.gg (Developer Settings > Personal Access Tokens sur start.gg).
# NE JAMAIS commiter de vraie valeur ici.
STARTGG_TOKEN=

# Slug de l'event start.gg à suivre. Change à chaque nouveau tournoi.
# Correspond à la partie d'URL après https://www.start.gg/
# Exemple : tournament/ceo-2026/event/marvel-tokon-fighting-souls
STARTGG_EVENT_SLUG=tournament/ceo-2026/event/marvel-tokon-fighting-souls

# Durée de cache (secondes) des appels API start.gg côté serveur.
STARTGG_CACHE_SECONDS=30

# --- Cercle de parieurs (phase 1) ---
# Nombre maximum de comptes pouvant être créés.
MAX_USERS=30

# Code d'invitation à fournir à l'inscription pour rejoindre le cercle.
INVITE_CODE=change-me

# Solde de départ en Ex (monnaie virtuelle du site) crédité à la création
# d'un compte. Garder synchronisé avec le défaut de User.exBalance côté
# schéma Prisma (prisma/schema.prisma).
DEFAULT_STARTING_EX=10000

# Secret utilisé pour protéger la route de synchronisation des résultats
# (POST /api/admin/sync-results).
ADMIN_SYNC_SECRET=change-me

# --- Base de données (PostgreSQL) ---
# Le système de fichiers de Vercel est éphémère : SQLite n'y fonctionne pas,
# il faut une vraie base Postgres (Vercel Postgres / Prisma Postgres, Neon,
# Supabase...). Utilisez la chaîne de connexion DIRECTE (schéma
# "postgresql://..."), pas une URL Accelerate ("prisma+postgres://...") :
# l'app tourne en Node.js classique (pas en edge) et Prisma Client s'y
# connecte nativement, sans dépendance supplémentaire.
#
# En dev local avec une Postgres locale :
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pari_fgc?schema=public"

# URL publique du site (sans slash final), pour les liens cliquables dans
# les réponses du bot Twitch (ex. https://impactobet.fr).
SITE_URL=

# --- NextAuth ---
# Générer avec: npx auth secret
AUTH_SECRET=

# --- Phase 2 (optionnel, pour plus tard) : login via Discord ---
# Créer une application sur https://discord.com/developers/applications
# AUTH_DISCORD_ID=
# AUTH_DISCORD_SECRET=

# --- Twitch (bot de chat + paris "!bet") ---
# Identifiants de l'application Twitch (https://dev.twitch.tv/console/apps),
# utilisés pour l'auth du bot (client_credentials) et les flux OAuth
# (liaison de compte streamer/parieur). Client Secret : ne jamais commiter
# de vraie valeur.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Secret CHOISI PAR VOUS (pas fourni par Twitch), utilisé pour signer et
# vérifier les événements EventSub reçus sur /api/twitch/webhook. Généré une
# fois puis gardé stable ; toute chaîne aléatoire de 10 à 100 caractères
# convient (exigence Twitch). Générer avec :
#   openssl rand -hex 32
# Sans cette variable, "Activer le chat betting" échoue avec
# "TWITCH_WEBHOOK_SECRET n'est pas configuré."
TWITCH_WEBHOOK_SECRET=

# --- Email (portail self-service prestataire Invitational) ---
# Clé API Resend (https://resend.com) et adresse d'expédition, utilisées
# pour envoyer le lien d'accès aux prestataires identifiés manuellement
# (sans compte Twitch) une fois leur demande confirmée. Sans ces deux
# variables, l'envoi est journalisé (console) et ignoré au lieu d'échouer —
# le lien reste consultable/copiable depuis l'admin.
RESEND_API_KEY=
EMAIL_FROM=
